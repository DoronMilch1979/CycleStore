# Copy this file to .env.local for Next.js, and/or .env for Drizzle CLI scripts.
# Never commit real secrets. Never use production credentials in local or preview.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (Neon later; local Docker Postgres for development)
# Local Docker (see docker-compose.yml):
DATABASE_URL=postgres://cyclestore:cyclestore_dev@localhost:15432/cyclestore
#
# After Neon is approved, replace with the matching branch connection string:
# Development Neon branch → local
# Preview Neon branch → Vercel Preview
# Production Neon branch → Vercel Production only
#
# Vercel DATABASE_URL must be the pooled Neon host (the hostname contains
# `-pooler`). The app keeps one connection per server instance and disables
# prepared statements for that pooler. Use the direct host (no `-pooler`) only
# when running migrations, and do not put the direct URL in Vercel.
# Keep the Neon compute in the same region as the Vercel project, and turn off
# scale-to-zero for production so the first click after a quiet period is not
# waiting for the database to wake up.
# Example pooled URL (placeholders only):
# DATABASE_URL=postgres://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/cyclestore?sslmode=require

# ---------------------------------------------------------------------------
# Authentication (Better Auth)
# Generate a high-entropy secret, at least 32 characters:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-32-character-or-longer-secret
BETTER_AUTH_URL=http://localhost:3000

# Bootstrap administrator (seed script only; never exposed to the client)
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@internal.local
# Local bootstrap password is 123456 (see README). Leave empty until you seed.
ADMIN_BOOTSTRAP_PASSWORD=123456

# ---------------------------------------------------------------------------
# Media storage
# local = disk under /storage/uploads (default for development)
# vercel-blob = Vercel Blob (do not enable until explicitly approved)
MEDIA_DRIVER=local
# BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Future Google login (leave empty until configured)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
